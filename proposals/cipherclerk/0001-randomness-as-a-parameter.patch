+//! Randomness as a parameter: everything `signing` offers works with a
+//! caller-supplied CSPRNG and without the `os-rng` feature. Gated on
+//! `signing` alone, so `cargo test --no-default-features --features
+//! signing` exercises the path a PVM / zkVM guest uses.
+
+#![cfg(feature = "signing")]
+
+use cipher_clerk::crypto::blake2b_256;
+use cipher_clerk::prelude::*;
+use cipher_clerk::state::Opening;
+use cipher_clerk::{OpeningsOracle, VecLedger};
+use rand_core::{CryptoRng, RngCore};
+
+/// A deterministic RNG for tests: blake2b over (seed, counter). Stands
+/// in for whatever seeded CSPRNG a guest is handed.
+struct SeededRng {
+    seed: [u8; 32],
+    counter: u64,
+}
+
+impl SeededRng {
+    fn new(seed: u8) -> Self {
+        Self {
+            seed: [seed; 32],
+            counter: 0,
+        }
+    }
+}
+
+impl RngCore for SeededRng {
+    fn next_u32(&mut self) -> u32 {
+        rand_core::impls::next_u32_via_fill(self)
+    }
+    fn next_u64(&mut self) -> u64 {
+        rand_core::impls::next_u64_via_fill(self)
+    }
+    fn fill_bytes(&mut self, dest: &mut [u8]) {
+        for chunk in dest.chunks_mut(32) {
+            let block = blake2b_256(
+                b"cipher-clerk/test/seeded-rng",
+                &[&self.seed, &self.counter.to_le_bytes()],
+            );
+            self.counter += 1;
+            chunk.copy_from_slice(&block[..chunk.len()]);
+        }
+    }
+    fn try_fill_bytes(&mut self, dest: &mut [u8]) -> Result<(), rand_core::Error> {
+        self.fill_bytes(dest);
+        Ok(())
+    }
+}
+
+impl CryptoRng for SeededRng {}
+
+/// Open a journal and two accounts, then build and sign one transfer,
+/// drawing every random input from `rng`.
+fn scenario(rng: &mut SeededRng) -> (VecLedger, OpeningsOracle, Vec<CreateAccount>, Transfer) {
+    let registrar = Keypair::generate_with(rng);
+    let journal = Journal::new(JournalId::random_with_rng(rng), registrar.public, 1);
+    let jid = journal.id;
+    let mut ledger = VecLedger::new();
+    ledger.set_journal(journal);
+
+    let value = 100u64;
+    let blinding = Blinding::random(rng);
+    let amount = Amount::commit(value, &blinding);
+    let oracle = OpeningsOracle::new(vec![Opening {
+        amount,
+        value,
+        blinding,
+    }]);
+
+    let alice_kp = Keypair::generate_with(rng);
+    let bob_kp = Keypair::generate_with(rng);
+    let alice = Account::open_with_rng(
+        AccountKind::Asset,
+        jid,
+        alice_kp.public,
+        Iso4217::USD,
+        BankCode::Vault,
+        rng,
+    );
+    let bob =
+        Account::liability_with_rng(jid, bob_kp.public, Iso4217::USD, BankCode::Checking, rng);
+    let creations = vec![
+        CreateAccount::signed_with(alice.clone(), &registrar.secret, rng),
+        CreateAccount::signed_with(bob.clone(), &registrar.secret, rng),
+    ];
+
+    let transfer = Transfer::builder_with_rng(jid, rng)
+        .debit(&alice, Layer::Settled, amount)
+        .credit(&bob, Layer::Settled, amount)
+        .signed_with_rng(&[(&alice, &alice_kp.secret)], rng);
+    (ledger, oracle, creations, transfer)
+}
+
+#[test]
+fn kernel_accepts_a_transfer_built_with_a_caller_rng() {
+    let (mut ledger, mut oracle, creations, transfer) = scenario(&mut SeededRng::new(1));
+    for r in cipher_clerk::apply_account_creations(&mut ledger, &creations, &mut oracle, 1_000) {
+        assert_eq!(r.status, EventStatus::Created);
+    }
+    let results = cipher_clerk::apply_batch(&mut ledger, &[transfer], &mut oracle, 2_000);
+    assert_eq!(results.len(), 1);
+    assert_eq!(results[0].status, EventStatus::Created);
+}
+
+#[test]
+fn same_seed_gives_the_same_transfer() {
+    let (_, _, _, a) = scenario(&mut SeededRng::new(7));
+    let (_, _, _, b) = scenario(&mut SeededRng::new(7));
+    let (_, _, _, c) = scenario(&mut SeededRng::new(8));
+    assert_eq!(a.signing_payload(), b.signing_payload());
+    assert_eq!(a.signatures, b.signatures);
+    assert_ne!(a.id, c.id);
+    assert_ne!(a.signatures, c.signatures);
+}
+
+#[test]
+fn builder_entry_ids_are_distinct() {
+    let mut rng = SeededRng::new(3);
+    let kp = Keypair::generate_with(&mut rng);
+    let jid = JournalId::random_with_rng(&mut rng);
+    let a = Account::asset_with_rng(jid, kp.public, Iso4217::USD, BankCode::Vault, &mut rng);
+    let amount = Amount::commit(1, &Blinding::random(&mut rng));
+    let t1 = Transfer::builder_with_rng(jid, &mut rng)
+        .debit(&a, Layer::Settled, amount)
+        .credit(&a, Layer::Settled, amount)
+        .debit(&a, Layer::Pending, amount)
+        .build_unsigned();
+    let t2 = Transfer::builder_with_rng(jid, &mut rng)
+        .debit(&a, Layer::Settled, amount)
+        .build_unsigned();
+    let mut ids: Vec<EntryId> = t1.entries.iter().chain(&t2.entries).map(|e| e.id).collect();
+    let n = ids.len();
+    ids.sort();
+    ids.dedup();
+    assert_eq!(ids.len(), n, "entry ids must not repeat");
+    assert_ne!(t1.id, t2.id);
+}
+
+#[cfg(feature = "viewing-keys")]
+#[test]
+fn envelope_seals_with_a_caller_rng() {
+    let mut rng = SeededRng::new(5);
+    let spend = SpendKey::generate_with_rng(&mut rng);
+    let ivk = spend.incoming_viewing_key();
+    let blinding = Blinding::random(&mut rng);
+    let env = EncryptedEnvelope::seal_with_rng(42, &blinding, &ivk.public(), &mut rng)
+        .expect("valid recipient key");
+    let (value, opened) = env.open(&ivk).expect("opens with the matching ivk");
+    assert_eq!(value, 42);
+    assert_eq!(opened.0, blinding.0);
+}
