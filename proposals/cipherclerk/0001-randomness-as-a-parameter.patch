-# Off-VM helpers: signing, commitment generation, hash-to-curve. Pulls in rand.
-signing = ["dep:rand_core", "rand_core/getrandom"]
+# Signing, key generation, commitment blindings and envelope sealing.
+# Every function that needs randomness takes the caller's
+# `R: RngCore + CryptoRng`; nothing here reaches for the operating
+# system, so `signing` builds for targets `getrandom` does not support
+# (PVM / zkVM guests). Pulls in `rand_core` without `getrandom`.
+signing = ["dep:rand_core"]
+# Convenience wrappers that draw from the operating system (`OsRng`):
+# `Keypair::generate`, `AccountId::random`, `Transfer::signed_by`,
+# `CreateAccount::signed`, `EncryptedEnvelope::seal`, ... Each one is a
+# thin shim over an always-available `*_with_rng` / `*_with` variant.
+# Off-VM only. Implies signing.
+os-rng = ["signing", "rand_core/getrandom"]
 # Off-VM convenience: in-memory LedgerState + Oracle, ergonomic commit
-# helpers, ID random generators. Implies signing.
-helpers = ["signing"]
+# helpers, ID random generators. Implies signing and os-rng.
+helpers = ["signing", "os-rng"]
 # Test-only shadow oracle: lets property tests track plaintext alongside commitments.
 shadow = []
 
