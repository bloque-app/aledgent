diff --git a/Cargo.toml b/Cargo.toml
index 417c2a8..9efcccb 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -102,9 +102,9 @@ bech32 = { version = "0.11", default-features = false, features = ["alloc"], opt
 # depending on the layout or mutable state of a sibling VOS checkout. On
 # non-PVM builds the shim's typed API falls through to dalek, so the same code
 # path runs in tests. Enabled by the `pvm-precompile` feature.
-zkpvm-precompiles = { git = "https://codeberg.org/Virto/VOS.git", rev = "9f5337fb39ccad5b779cf72cbd617e726e325aed", optional = true }
