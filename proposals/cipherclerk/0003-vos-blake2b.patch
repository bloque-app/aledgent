Date: Sat, 3 Oct 2026 13:59:29 -0500
Subject: [PATCH 3/5] perf(crypto): hash with VOS's BLAKE2b behind vos-blake2b

On a VOS PVM guest, blake2b_256 and blake2b_512 dominate a kernel
transition: a reservation in aledgent's core hashes about 8 470 times
(sparse-Merkle paths), and the blake2 crate's compression plus the digest
wrapper's per-hash buffer copies cost about 16 k gas a one-block hash.
The new vos-blake2b feature routes both through vos_protocol::blake2b: a
compression scheduled for the PVM's 13 registers and 25-cycle memory
accesses (or VOS's precompile 100 where the runtime serves it), streaming
whole blocks in place. Off the guest it is blake2b_simd. The digests are
the blake2 crate's (tests/vos_blake2b.rs at every block boundary).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Cargo.toml           |  6 ++++++
 src/crypto/hash.rs   | 24 ++++++++++++++++++++----
 tests/vos_blake2b.rs | 35 +++++++++++++++++++++++++++++++++++
 3 files changed, 61 insertions(+), 4 deletions(-)
 create mode 100644 tests/vos_blake2b.rs

diff --git a/Cargo.toml b/Cargo.toml
index f52388b..417c2a8 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -75,6 +75,10 @@ roadmap = ["viewing-keys", "voucher", "disclosure", "settlement", "notes"]
 # computation.  On non-PVM builds the shim falls through to dalek
 # via host-fallback, so the same code path runs in tests.
 pvm-precompile = ["dep:zkpvm-precompiles"]
+# VOS's BLAKE2b (vos-protocol): on a PVM guest, a compression scheduled for the
+# PVM's 13 registers and 25-cycle memory accesses, about a third of the gas of
+# the `blake2` crate's per hash; the same digests everywhere.
+vos-blake2b = ["dep:vos-protocol"]
 
 [dependencies]
 rkyv = { version = "0.8", default-features = false, features = ["alloc", "bytecheck", "little_endian", "pointer_width_32"] }
@@ -99,6 +103,8 @@ bech32 = { version = "0.11", default-features = false, features = ["alloc"], opt
 # non-PVM builds the shim's typed API falls through to dalek, so the same code
 # path runs in tests. Enabled by the `pvm-precompile` feature.
 zkpvm-precompiles = { git = "https://codeberg.org/Virto/VOS.git", rev = "9f5337fb39ccad5b779cf72cbd617e726e325aed", optional = true }
+# VOS's protocol primitives (no_std), for `vos-blake2b`.
+vos-protocol = { git = "https://codeberg.org/pandres95/VOS.git", rev = "6c794311ba506092be114ff5344fef4e338a8a85", optional = true }
 
 [dev-dependencies]
 proptest = "1"
