 /// archived bytes into Merkle node hashes or message digests.
 pub fn blake2b_256(domain: &[u8], parts: &[&[u8]]) -> [u8; 32] {
-    #[cfg(feature = "pvm-precompile")]
+    // VOS's BLAKE2b: on a PVM guest a compression scheduled for the 13-register
