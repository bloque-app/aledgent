-    #[cfg(not(feature = "pvm-precompile"))]
+    #[cfg(not(any(feature = "pvm-precompile", feature = "vos-blake2b")))]
     {
         let mut h = Blake2b256::new();
         h.update(domain);
@@ -29,11 +37,19 @@ pub fn blake2b_256(domain: &[u8], parts: &[&[u8]]) -> [u8; 32] {
 /// challenge derivation and hash-to-curve where wide reduction matters;
 /// exposed for users building compatible signing or commitment helpers.
 pub fn blake2b_512(domain: &[u8], parts: &[&[u8]]) -> [u8; 64] {
