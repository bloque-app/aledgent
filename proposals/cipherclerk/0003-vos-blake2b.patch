diff --git a/tests/vos_blake2b.rs b/tests/vos_blake2b.rs
new file mode 100644
index 0000000..b3b93bd
--- /dev/null
+++ b/tests/vos_blake2b.rs
@@ -0,0 +1,35 @@
+//! `blake2b_256` / `blake2b_512` give the `blake2` crate's digests whichever backend the
+//! features select (with `vos-blake2b`, VOS's `vos_protocol::blake2b`).
+use blake2::digest::consts::{U32, U64};
+use blake2::{Blake2b, Digest};
+use cipher_clerk::crypto::{blake2b_256, blake2b_512};
+
+fn reference<D: Digest>(domain: &[u8], parts: &[&[u8]]) -> Vec<u8> {
+    let mut h = D::new();
+    h.update(domain);
+    for p in parts {
+        h.update(p);
+    }
+    h.finalize().to_vec()
+}
+
+#[test]
+fn digests_match_the_blake2_crate_at_every_block_boundary() {
+    let data: Vec<u8> = (0..1000u32).map(|i| (i * 37 + 11) as u8).collect();
+    for len in [0, 1, 63, 64, 103, 104, 105, 127, 128, 129, 255, 256, 257, 640, 1000] {
+        for split in [0, len / 3, len] {
+            let (a, b) = data[..len].split_at(split);
+            let domain = b"cipher-clerk/smt/node/v1";
+            assert_eq!(
+                blake2b_256(domain, &[a, b]).to_vec(),
+                reference::<Blake2b<U32>>(domain, &[a, b]),
+                "256, len {len}, split {split}"
+            );
+            assert_eq!(
+                blake2b_512(domain, &[a, b]).to_vec(),
+                reference::<Blake2b<U64>>(domain, &[a, b]),
+                "512, len {len}, split {split}"
+            );
+        }
+    }
+}
