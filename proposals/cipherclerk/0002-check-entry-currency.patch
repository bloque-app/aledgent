+//! An entry posts in its account's currency: `entry.ledger` must equal
+//! the `ledger` of the account it touches.
+//!
+//! The zero-sum check groups entries by their own `(ledger, layer)`.
+//! Without this check, a transfer could label both legs USD while the
+//! credited account holds EUR: the USD group balances, and value moves
+//! between currencies at a rate nobody signed up for.
+
+#![cfg(feature = "helpers")]
+
+use cipher_clerk::helpers::{MemLedger, MemOracle};
+use cipher_clerk::prelude::*;
+
+const USD: u32 = 840;
+const EUR: u32 = 978;
+
+struct Book {
+    ledger: MemLedger,
+    oracle: MemOracle,
+    journal: JournalId,
+    alice: Account,
+    alice_kp: Keypair,
+    bob_usd: Account,
+    carol_eur: Account,
+    carol_kp: Keypair,
+}
+
+/// Alice holds USD; Bob holds USD; Carol holds EUR. One journal.
+fn book() -> Book {
+    let mut ledger = MemLedger::new();
+    let mut oracle = MemOracle::new();
+    let registrar = Keypair::generate();
+    let journal = ledger.bootstrap_journal(registrar.public, 1);
+    let alice_kp = Keypair::generate();
+    let bob_kp = Keypair::generate();
+    let carol_kp = Keypair::generate();
+    let alice = Account::asset(journal, alice_kp.public, USD, 100);
+    let bob_usd = Account::liability(journal, bob_kp.public, USD, 200);
+    let carol_eur = Account::liability(journal, carol_kp.public, EUR, 200);
+    let r = cipher_clerk::apply_account_creations(
+        &mut ledger,
+        &[
+            CreateAccount::signed(alice.clone(), &registrar.secret),
+            CreateAccount::signed(bob_usd.clone(), &registrar.secret),
+            CreateAccount::signed(carol_eur.clone(), &registrar.secret),
+        ],
+        &mut oracle,
+        500_000,
+    );
+    for s in &r {
+        assert_eq!(s.status, EventStatus::Created);
+    }
+    Book {
+        ledger,
+        oracle,
+        journal,
+        alice,
+        alice_kp,
+        bob_usd,
+        carol_eur,
+        carol_kp,
+    }
+}
+
+/// A two-leg transfer whose entries carry the given ledgers, whatever
+/// the accounts hold.
+fn two_legs(
+    b: &mut Book,
+    debit: (&Account, u32),
+    credit: (&Account, u32),
+    signer: &SecretKey,
+) -> Transfer {
+    let amount = b.oracle.commit(100);
+    let id = TransferId::random();
+    let entries = vec![
+        Entry::debit(
+            EntryId::random(),
+            id,
+            b.journal,
+            debit.0.id,
+            Layer::Settled,
+            amount,
+            debit.1,
+            debit.0.code,
+        ),
+        Entry::credit(
+            EntryId::random(),
+            id,
+            b.journal,
+            credit.0.id,
+            Layer::Settled,
+            amount,
+            credit.1,
+            credit.0.code,
+        ),
+    ];
+    Transfer::draft(id, b.journal, entries).signed_by(&[signer])
+}
+
+#[test]
+fn credit_leg_in_another_currency_is_refused() {
+    let mut b = book();
+    let (alice, carol) = (b.alice.clone(), b.carol_eur.clone());
+    let signer = b.alice_kp.secret.clone();
+    // Both legs say USD, so the (USD, Settled) group balances; Carol's
+    // account is EUR.
+    let t = two_legs(&mut b, (&alice, USD), (&carol, USD), &signer);
+    let tid = t.id;
+    let r = cipher_clerk::apply_batch(&mut b.ledger, &[t], &mut b.oracle, 1_000_000);
+    assert_eq!(r[0].status, EventStatus::EntryLedgerMustMatchAccount);
+    assert!(b.ledger.get_transfer(&tid, &mut b.oracle).is_none());
+}
+
+#[test]
+fn debit_leg_in_another_currency_is_refused() {
+    let mut b = book();
+    let (carol, bob) = (b.carol_eur.clone(), b.bob_usd.clone());
+    let signer = b.carol_kp.secret.clone();
+    // Carol (EUR) is debited on an entry labelled USD.
+    let t = two_legs(&mut b, (&carol, USD), (&bob, USD), &signer);
+    let r = cipher_clerk::apply_batch(&mut b.ledger, &[t], &mut b.oracle, 1_000_000);
+    assert_eq!(r[0].status, EventStatus::EntryLedgerMustMatchAccount);
+}
+
+#[test]
+fn entries_in_their_accounts_currency_are_accepted() {
+    let mut b = book();
+    let (alice, bob) = (b.alice.clone(), b.bob_usd.clone());
+    let signer = b.alice_kp.secret.clone();
+    let t = two_legs(&mut b, (&alice, USD), (&bob, USD), &signer);
+    let r = cipher_clerk::apply_batch(&mut b.ledger, &[t], &mut b.oracle, 1_000_000);
+    assert_eq!(r[0].status, EventStatus::Created);
+}
+
+#[test]
+fn builder_transfers_carry_the_accounts_currency() {
+    // The builder copies `account.ledger` into each entry, so a
+    // cross-currency builder transfer fails the zero-sum, not the new
+    // check: the new check only catches hand-built entries.
+    let mut b = book();
+    let amount = b.oracle.commit(100);
+    let t = Transfer::builder(b.journal)
+        .debit(&b.alice, Layer::Settled, amount)
+        .credit(&b.carol_eur, Layer::Settled, amount)
+        .signed_with(&[(&b.alice, &b.alice_kp.secret)]);
+    let r = cipher_clerk::apply_batch(&mut b.ledger, &[t], &mut b.oracle, 1_000_000);
+    assert_eq!(r[0].status, EventStatus::UnbalancedTransfer);
+}
