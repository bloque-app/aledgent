{
  "listen": "0.0.0.0:8080",
  "readiness_listen": "0.0.0.0:8081",
  "replica": "ingress",
  "profile": "development",
  "require_sync_standby": false,
  "tokens": [],
  "allow_holder_credentials": true,
  "tick_interval_ms": 1000,
  "decision_bound_ms": 60000,
  "core_journal": "/var/lib/aledgent/core.journal",
  "genesis": {
    "assets": [
      { "id": "CRD", "precision": 2, "kind": "other" }
    ],
    "operator_verifier": "<filled by the guide: the SHA-256 of the operator's token, hex (public)>",
    "deployment": "<filled by the guide: 16 random bytes, hex, chosen once (public)>",
    "decision_bound_ms": 60000,
    "review_service_level_ms": 3600000,
    "default_deadlines_ms": {
      "reserve": 600000,
      "transfer": 600000,
      "redeem": 600000
    },
    "genesis_op": "<filled by the guide: 16 random bytes, hex, chosen once (public)>",
    "genesis_at": 0
  },
  "core_endpoint": "unix:/run/aledgent/core.sock",
  "core_link": {
    "token_sha256": ["<filled by the guide: the SHA-256 of the core link's token, hex>"],
    "peer_uids": [65532]
  },
  "core_keys": {
    "signer": {
      "socket": "/run/aledgent-signer/signer.sock",
      "client": "core",
      "token_file": "/etc/aledgent/core-signer.token"
    },
    "key_ring": "keyring",
    "clerk": "clerk",
    "agent_authority": "agent-authority",
    "agent_package": "agent-package"
  }
}
