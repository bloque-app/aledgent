          "legendFormat": "unacknowledged Authority decisions (limit 256)"
        },
        {
          "refId": "C",
          "expr": "aledgent_writer_fenced_seconds",
          "legendFormat": "writer fenced, seconds (alert past 300)"
        }
      ]
