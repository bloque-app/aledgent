          "instant": true,
          "legendFormat": "{{store}}"
        },
        {
          "refId": "B",
          "expr": "aledgent_drill_last_age_ms",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "aledgent_drill_passed",
          "format": "table",
          "instant": true
        }
