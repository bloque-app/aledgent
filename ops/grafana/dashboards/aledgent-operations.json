{
  "title": "aledgent — operations",
  "uid": "aledgent-operations",
  "description": "F-018, T-018-05: NFR-11's six signals (the anchor lag from F-017), the ticker, the Needs-Review queue with its owner and service level, block production, backups and the drill. Every value is a count, an age in milliseconds or the layer's integer units; none is a ledger fact.",
  "schemaVersion": 39,
  "version": 2,
  "editable": false,
  "tags": [
    "aledgent",
    "F-018"
  ],
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Prometheus"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Oldest non-terminal operation (REQ-OP-8)",
      "description": "NFR-11: age of the oldest non-terminal operation, and of the oldest row ingress holds undecided (REQ-CS-7). Pages over its service level.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_oldest_non_terminal_age_ms",
          "legendFormat": "oldest non-terminal"
        },
        {
          "refId": "B",
          "expr": "aledgent_oldest_undecided_row_age_ms",
          "legendFormat": "oldest Received row"
        },
        {
          "refId": "C",
          "expr": "aledgent_operations_open",
          "legendFormat": "open"
        },
        {
          "refId": "D",
          "expr": "aledgent_operations_received",
          "legendFormat": "Received"
        }
      ]
    },
    {
      "id": 2,
      "type": "table",
      "title": "Needs-Review queue (REQ-OP-6, AC-C4.1)",
      "description": "The review queue with its owner (the label `owner`) and its service level. Every entry past the service level pages its owner. The operations themselves are listed on CTR-OPS, to an operator with authority: this dashboard carries no operation reference.",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_review_queue",
          "format": "table",
          "instant": true,
          "legendFormat": "{{owner}}"
        },
        {
          "refId": "B",
          "expr": "aledgent_needs_review",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "aledgent_review_overdue",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "aledgent_review_most_overdue_ms",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "aledgent_review_service_level_ms",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Observation completeness (REQ-SA-7, REQ-IN-5)",
      "description": "NFR-11: the adapter's cursor lag behind the finalized inbox, open gaps, and chain mismatches (the entries read do not lead to the head the layer holds). Any gap or mismatch pages.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_observation_cursor_lag",
          "legendFormat": "cursor lag"
        },
        {
          "refId": "B",
          "expr": "aledgent_adapter_alerts{kind=\"gap\"}",
          "legendFormat": "open gaps"
        },
        {
          "refId": "C",
          "expr": "aledgent_observation_chain_mismatches",
          "legendFormat": "chain mismatches"
        },
        {
          "refId": "E",
          "expr": "aledgent_observation_stopped",
          "legendFormat": "stopped, waiting for an operator"
        },
        {
          "refId": "D",
          "expr": "aledgent_observation_gaps_total",
          "legendFormat": "gaps, ever"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Undelivered notifications (REQ-EV-6)",
      "description": "NFR-11: count and age of undelivered notifications.",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_undelivered_notifications",
          "legendFormat": "undelivered"
        },
        {
          "refId": "B",
          "expr": "aledgent_oldest_undelivered_age_ms",
          "legendFormat": "oldest, ms"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Anchor lag (F-017)",
      "description": "NFR-11: time since the newest Final checkpoint was created, and how long the checkpoint in flight has waited. Pages over twice the cadence, or an hour in flight.",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_anchor_lag_ms",
          "legendFormat": "anchor lag"
        },
        {
          "refId": "B",
          "expr": "aledgent_anchor_in_flight_age_ms",
          "legendFormat": "in flight"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Reconciliation per axis (NFR-9)",
      "description": "NFR-11: the outcome of the daily reconciliation per axis, at one minor unit and zero tolerance. Any difference, or no run in 24 h, pages. Axis 3 is F-017's settlement comparison.",
      "gridPos": {
        "x": 6,
        "y": 13,
        "w": 18,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_reconciliation_differences",
          "format": "table",
          "instant": true,
          "legendFormat": "axis {{axis}}"
        },
        {
          "refId": "B",
          "expr": "aledgent_reconciliation_last_run_age_ms",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "aledgent_reconciliation_ran",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Liquidity of settlement positions (REQ-SN-2)",
      "description": "NFR-11: the instance's position per asset and each lane's native balance, in the layer's integer units; open shortfalls page.",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_position",
          "legendFormat": "position {{asset}}"
        },
        {
          "refId": "B",
          "expr": "aledgent_lane_native",
          "legendFormat": "lane {{lane}}"
        },
        {
          "refId": "C",
          "expr": "aledgent_lane_under_fee_floor",
          "legendFormat": "under floor {{lane}}"
        },
        {
          "refId": "D",
          "expr": "aledgent_liquidity_alerts",
          "legendFormat": "shortfalls {{kind}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Ticker (DEC-6, RISK-7)",
      "description": "Time since the core applied its last tick: deadlines move only on ticks.",
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
