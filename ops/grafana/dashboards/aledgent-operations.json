      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_signals_up",
          "format": "table",
          "instant": true,
          "legendFormat": "{{source}}"
        },
        {
          "refId": "B",
          "expr": "aledgent_adapter_signals_age_ms",
