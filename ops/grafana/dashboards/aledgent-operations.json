      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_ticker_age_ms",
          "legendFormat": "ticker age"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Block production (Kreivo's runtime)",
      "description": "The settlement layer's finalized height and how long it has not moved: blocks need a crank when the chain is idle.",
      "gridPos": {
        "x": 18,
        "y": 18,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aledgent_finalized_height",
          "legendFormat": "finalized"
        },
        {
          "refId": "B",
          "expr": "aledgent_finalized_stall_ms",
          "legendFormat": "stalled, ms"
        }
      ]
    },
    {
      "id": 10,
      "type": "table",
      "title": "Backups and the restore drill (NFR-4, NFR-10)",
