+                        }
+                        Err(err) => {
+                            println!("  {variant} failed: {err}");
+                            break;
+                        }
+                    }
+                }
+                if !e2e.is_empty() {
+                    println!("== {spike}x {case} {variant} ==");
+                    summary("  caller us (invoke + ack, excl. staging)", &e2e);
+                    summary("  invoke elapsed_us", &exec_us);
+                    summary("  invoke runtime gas", &gas);
+                    summary("  actor gas", &actor_gas);
+                }
+            }
+        }
+    }
+    csv.flush().unwrap();
+}
