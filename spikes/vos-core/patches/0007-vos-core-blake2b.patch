diff --git a/Cargo.toml b/Cargo.toml
index c02217a..8a51b97 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -79,6 +79,10 @@ pvm-precompile = ["dep:zkpvm-precompiles"]
 # PVM's 13 registers and 25-cycle memory accesses, about a third of the gas of
 # the `blake2` crate's per hash; the same digests everywhere.
 vos-blake2b = ["dep:vos-protocol"]
+# vos-core's BLAKE2b precompile (0x400, one compression a call) through its guest shim
+# `vos-pvm-precompiles`, software where the host answers WHAT: the aledgent vos-core spike (W2).
+# Curves stay in software. Takes precedence over `vos-blake2b` and `pvm-precompile` for hashing.
+vos-core-blake2b = ["dep:vos-core-precompiles"]
 
 [dependencies]
 rkyv = { version = "0.8", default-features = false, features = ["alloc", "bytecheck", "little_endian", "pointer_width_32"] }
@@ -103,6 +107,8 @@ bech32 = { version = "0.11", default-features = false, features = ["alloc"], opt
 # non-PVM builds the shim's typed API falls through to dalek, so the same code
 # path runs in tests. Enabled by the `pvm-precompile` feature.
 zkpvm-precompiles = { package = "vos-pvm-precompiles", git = "https://codeberg.org/pandres95/VOS.git", rev = "bd8d1bb70551391a4c80a96c2249313ab7e0a0fc", optional = true }
+# vos-core's guest precompile shims, for `vos-core-blake2b`.
+vos-core-precompiles = { package = "vos-pvm-precompiles", git = "https://github.com/virto-network/vos", rev = "1650c474da06408026923b8397d338d767e1cd27", optional = true }
 # VOS's protocol primitives (no_std), for `vos-blake2b`.
 vos-protocol = { git = "https://codeberg.org/pandres95/VOS.git", rev = "bd8d1bb70551391a4c80a96c2249313ab7e0a0fc", optional = true }
 
